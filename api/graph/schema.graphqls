# Schéma GraphQL de PumpCast.
#
# Chaque page du front demande exactement les champs dont elle a besoin :
# l'accueil veut les prix actuels de quelques stations proches, la fiche
# station veut l'historique et la prédiction, la comparaison veut plusieurs
# courbes. Les champs lourds (priceHistory, prediction) ne sont calculés
# que s'ils sont demandés.
#
# Les comptes, favoris et alertes (me, register, login...) arrivent en phase 6.

enum Fuel {
  GAZOLE
  SP95
  SP98
  E10
  E85
  GPLC
}

enum Recommendation {
  FILL_NOW
  WAIT
  STABLE
}

enum StationSort {
  DISTANCE
  # Nécessite le paramètre fuel
  PRICE
}

type Station {
  id: ID!
  address: String!
  city: String!
  postalCode: String!
  department: String!
  # Nulles pour quelques anciennes stations des archives, sans coordonnées
  latitude: Float
  longitude: Float
  # "R" route, "A" autoroute
  roadType: String!
  services: [String!]!
  openingHours: OpeningHours!
  # Vide si la station n'est plus dans le flux du jour (station fermée)
  currentPrices: [CurrentPrice!]!
  # Un point par jour, du plus ancien au plus récent. 365 jours maximum.
  priceHistory(fuel: Fuel!, days: Int = 30): [PricePoint!]!
  prediction(fuel: Fuel!): Prediction
  # Renseigné seulement par stationsNear
  distanceKm: Float
}

type OpeningHours {
  automate24h: Boolean!
  days: [OpeningDay!]!
}

type OpeningDay {
  # 1 = lundi
  day: Int!
  name: String!
  closed: Boolean!
  slots: [TimeSlot!]!
}

type TimeSlot {
  open: String!
  close: String!
}

type CurrentPrice {
  fuel: Fuel!
  # Nuls quand la station signale une rupture sans prix connu
  price: Float
  updatedAt: String
  outOfStock: Boolean!
}

type PricePoint {
  # Date au format AAAA-MM-JJ
  date: String!
  price: Float!
}

type PredictedPoint {
  date: String!
  price: Float!
  low: Float!
  high: Float!
}

type Prediction {
  # Jour et prix de départ de la prévision (le dernier prix connu)
  baseDate: String!
  basePrice: Float!
  # Seulement les horizons où le modèle bat la baseline "le prix ne bouge pas"
  horizon: [PredictedPoint!]!
  # Nulle quand le modèle n'a pas de conseil assez sûr, ou que ce type de
  # conseil n'a pas fait gagner d'argent sur les données passées
  recommendation: Recommendation
  # Jour et prix visés par le conseil (dans les 3 prochains jours). Pas forcément
  # sur la courbe, qui n'affiche que les horizons qui battent la baseline.
  adviceTarget: PredictedPoint
  confidence: Float!
  reasons: [String!]!
  modelVersion: String!
  generatedAt: String!
}

type DepartmentStats {
  department: String!
  fuel: Fuel!
  # Date des chiffres du jour (le dernier jour connu)
  date: String!
  avgPrice: Float!
  minPrice: Float!
  maxPrice: Float!
  stationCount: Int!
  cheapestStation: Station
  # Moyenne du département jour par jour sur les 30 derniers jours
  trend30d: [PricePoint!]!
}

type DepartmentAverage {
  department: String!
  avgPrice: Float!
  stationCount: Int!
}

# Un entraînement du modèle et ses scores sur la période de test
type ModelRun {
  modelVersion: String!
  trainedAt: String!
  trainStart: String!
  trainEnd: String!
  testStart: String!
  testEnd: String!
  # Horizons affichés sur la courbe de prévision (ceux qui battent la baseline)
  allowedHorizons: [Int!]!
  horizons: [HorizonScore!]!
  # Conseils rejoués sur le test, avec seulement les types activés
  recommendations: RecommendationStats!
  # Types de conseil activés, et pour chacun le verdict validation / test
  enabledRecommendations: [Recommendation!]!
  recommendationRules: [RecommendationRule!]!
  recommendationCriteria: RecommendationCriteria!
  featureImportance: [FeatureImportance!]!
}

# Erreurs moyennes (MAE) en centimes sur la période de test
type HorizonScore {
  horizon: Int!
  maeBaseline: Float!
  maeRidge: Float!
  maeModel: Float!
  # Part des cas où le vrai prix tombe dans la fourchette (visé : 80 %)
  intervalCoverage: Float!
  beatsBaseline: Boolean!
  periods: [PeriodScore!]!
}

type PeriodScore {
  name: String!
  maeBaseline: Float!
  maeModel: Float!
}

# Recommandations rejouées sur la période de test
type RecommendationStats {
  accuracy: Float
  waitCount: Int!
  fillNowCount: Int!
  stableCount: Int!
  noneCount: Int!
  waitAccuracy: Float
  fillNowAccuracy: Float
  stableAccuracy: Float
  # Gain moyen en centimes par litre en suivant le conseil
  waitGainCents: Float
  fillNowGainCents: Float
}

# Un type de conseil n'est activé que s'il fait ses preuves sur la validation
# puis que le test le confirme
type RecommendationRule {
  kind: Recommendation!
  enabled: Boolean!
  passesValidation: Boolean!
  passesTest: Boolean!
  validationCount: Int!
  validationAccuracy: Float
  validationGainCents: Float
  testCount: Int!
  testAccuracy: Float
  testGainCents: Float
}

type RecommendationCriteria {
  minCountValidation: Int!
  minAccuracyValidation: Float!
  minCountTest: Int!
  minAccuracyTest: Float!
}

type FeatureImportance {
  feature: String!
  # Hausse de l'erreur (en centimes) quand on brouille cette variable
  maeIncrease: Float!
}

type Query {
  # Stations encore actives autour d'un point. radiusKm 50 max, limit 100 max.
  stationsNear(
    lat: Float!
    lng: Float!
    radiusKm: Float = 10
    fuel: Fuel
    sort: StationSort = DISTANCE
    limit: Int = 20
  ): [Station!]!
  station(id: ID!): Station
  # 5 stations maximum. Le carburant et la période se choisissent sur
  # priceHistory, c'est le client qui décide ce qu'il veut comparer.
  compareStations(ids: [ID!]!): [Station!]!
  departmentStats(department: String!, fuel: Fuel!): DepartmentStats
  # Moyenne du dernier jour pour chaque département, pour la carte de chaleur
  departmentAverages(fuel: Fuel!): [DepartmentAverage!]!
  # Entraînements du plus récent au plus ancien
  modelRuns(limit: Int = 10): [ModelRun!]!
}
