# Copier ce fichier en .env et adapter les valeurs.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pumpcast

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_PORT=8080
# Page /playground pour tester les requêtes GraphQL (mettre false en production)
ENABLE_PLAYGROUND=true
# Requêtes GraphQL autorisées par IP et par minute
RATE_LIMIT_PER_MINUTE=120
# true seulement derrière un proxy qui ajoute X-Forwarded-For (Render)
TRUST_PROXY=false

# --- Ingestion ---
# Flux instantané officiel (zip contenant un XML, mis à jour toutes les 10 min)
FEED_URL=https://donnees.roulez-eco.fr/opendata/instantane
# Départements dont on garde l'historique des prix (Auvergne-Rhône-Alpes par défaut).
# Les prix actuels sont gardés pour toute la France dans Redis.
# Mettre "all" pour stocker l'historique de toute la France (en local par exemple).
HISTORY_DEPARTMENTS=01,03,07,15,26,38,42,43,63,69,73,74
